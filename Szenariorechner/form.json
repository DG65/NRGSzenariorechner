{
    "elements": [
        {
            "type": "ExpansionPanel",
            "name": "ChangelogPanel",
            "caption": "🆕 Neu in dieser Version",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Neues Szenario \"Speichergröße\": simuliert den historischen Lastgang mit verschiedenen virtuellen Speichergrößen und zeigt Autarkiegrad und Amortisation je Größe gegenüber der aktuellen Speichergröße."
                },
                {
                    "type": "Button",
                    "caption": "Verstanden – nicht mehr anzeigen",
                    "onClick": "SZR_DismissChangelog($id, '0.2');"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "DocPanel",
            "caption": "📖 Dokumentation & Hilfe",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "name": "DocVersionLabel",
                    "caption": "ℹ️ Szenariorechner"
                },
                {
                    "type": "Label",
                    "caption": "Was-wäre-wenn-Wirtschaftlichkeitsrechner für den NRG-Stack: aktuell Szenarien \"Dynamischer Vertrag vs. Festpreis\" und \"Speichergröße\", weitere Szenarien (§14a-Beitritt, Förderende) folgen. Details im KONZEPT.md des Repos."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Anlagendaten",
            "expanded": true,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "PvKwp",
                    "caption": "PV-Leistung (kWp)",
                    "digits": 2
                },
                {
                    "type": "NumberSpinner",
