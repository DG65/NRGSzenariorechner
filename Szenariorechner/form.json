                },
                {
                    "type": "NumberSpinner",
                    "name": "SpeicherKwh",
                    "caption": "Speichergröße (kWh)",
                    "digits": 1
                },
                {
                    "type": "NumberSpinner",
                    "name": "EinspeiseverguetungCtKwh",
                    "caption": "Einspeisevergütung (ct/kWh)",
