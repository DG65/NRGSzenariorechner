                },
                {
                    "type": "Label",
                    "caption": "Client-ID/Secret aus dem OAuth-Manager im Netztransparenz-Extranet (https://api-portal.netztransparenz.de/). Werden nach dem Speichern sofort in die interne Zugangsdatenverwaltung übernommen und hier geleert."
                },
                {
                    "type": "PasswordTextBox",
                    "name": "NetztransparenzClientIdInput",
                    "caption": "Client-ID (einmalig eingeben)"
