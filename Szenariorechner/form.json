                },
                {
                    "type": "NumberSpinner",
                    "name": "FestpreisGrundpreisMonat",
                    "caption": "Grundpreis (€/Monat)",
                    "digits": 2
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Szenario: Speichergröße",
            "expanded": true,
            "items": [
                {
                    "type": "SelectVariable",
                    "name": "PvErzeugungVarID",
                    "caption": "PV-Erzeugung (archiviert, W)"
