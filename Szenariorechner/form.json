                },
                {
                    "type": "ValidationTextBox",
                    "name": "InbetriebnahmeDatum",
                    "caption": "Inbetriebnahmedatum (JJJJ-MM-TT)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Szenario: Dynamischer Vertrag",
            "expanded": true,
            "items": [
                {
                    "type": "SelectVariable",
                    "name": "NetzbezugVarID",
                    "caption": "Netzbezugsvariable (archiviert, kWh oder W)"
                },
                {
                    "type": "CheckBox",
