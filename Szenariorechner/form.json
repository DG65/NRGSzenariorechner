{
    "elements": [
        {
            "type": "ExpansionPanel",
            "name": "ChangelogPanel",
            "caption": "🆕 Neu in dieser Version",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Neu: Anlagenwerte, die automatisch von EMS kommen, stehen nicht mehr als 0 im Eingabefeld, sondern als Zeile mit Wert und Quelle (🔗). Eine eigene Eingabe (✏️) überschreibt den automatischen Wert; Eingabefelder erscheinen nur, wenn nichts automatisch kommt oder über den Knopf. Dazu je Verbindung eine Statuszeile (EMS, Tibber-Preiskurve)."
                },
                {
                    "type": "Button",
                    "caption": "Verstanden – nicht mehr anzeigen",
                    "onClick": "SZR_DismissChangelog($id, '0.7');"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "DocPanel",
            "caption": "📖 Dokumentation & Hilfe",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "name": "DocVersionLabel",
                    "caption": "ℹ️ Szenariorechner"
                },
                {
                    "type": "Label",
                    "caption": "Was-wäre-wenn-Wirtschaftlichkeitsrechner für den NRG-Stack: aktuell Szenarien \"Dynamischer Vertrag vs. Festpreis\", \"Speichergröße\" und \"§14a-Beitritt\", weiteres Szenario (Förderende/Solarspitzengesetz) folgt. Details im KONZEPT.md des Repos."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
